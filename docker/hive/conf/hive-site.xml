<?xml version="1.0"?>
<!--
Metastore embebido (Derby) persistido en un volumen, y warehouse de tablas
en el mismo HDFS que usa el resto del proyecto. hive.metastore.uris se deja
vacío aquí: lo fija hiveserver2 vía SERVICE_OPTS para hablar por thrift con
el servicio "metastore".
-->
<configuration>
    <property>
        <name>javax.jdo.option.ConnectionURL</name>
        <value>jdbc:derby:;databaseName=/opt/hive/data/metastore_db;create=true</value>
    </property>
    <property>
        <name>hive.metastore.warehouse.dir</name>
        <value>/user/hive/warehouse</value>
    </property>
    <property>
        <name>hive.metastore.schema.verification</name>
        <value>false</value>
    </property>
    <!--
    No hay YARN en este entorno (solo Spark standalone), así que Tez (motor
    por defecto en Hive 4) no puede lanzar su Application Master. Sin esto,
    hiveserver2 se queda reintentando precalentar el pool de sesiones Tez
    indefinidamente ("Hive Session ID = ..." repetido cada ~60s en los logs)
    y nunca llega a escuchar en el puerto 10000. "mr" funciona en local sin
    YARN (vía LocalJobRunner).
    -->
    <property>
        <name>hive.execution.engine</name>
        <value>mr</value>
    </property>
    <property>
        <name>hive.server2.tez.initialize.default.sessions</name>
        <value>false</value>
    </property>
    <!--
    Sin esto, HiveServer2 no arranca: al iniciar intenta consultar el ID de
    notificación actual del metastore (NotificationEventPoll, usado para
    replicación/refresco de vistas materializadas), pero el metastore no
    tiene el listener de notificaciones configurado
    (hive.metastore.transactional.event.listeners), así que esa llamada
    Thrift falla con "TApplicationException: Internal error processing
    get_current_notificationEventId" y HiveServer2 reintenta el arranque
    entero cada 60s para siempre. No necesitamos esta feature aquí.
    -->
    <property>
        <name>hive.notification.event.poll.interval</name>
        <value>0</value>
    </property>
    <!--
    Sin configurar hadoop.proxyuser.hive.* en core-site.xml, HiveServer2 no
    puede "impersonar" a NINGÚN usuario pasado con -n (ni siquiera "hive",
    su propio usuario del SO): AuthorizationException "User: hive is not
    allowed to impersonate ...". Como es un entorno de un solo usuario,
    desactivamos doAs: todas las queries se ejecutan como el usuario del
    proceso de HiveServer2 ("hive"), y el -n de beeline/Hue queda solo como
    identificador de sesión, no como impersonación real.
    -->
    <property>
        <name>hive.server2.enable.doAs</name>
        <value>false</value>
    </property>
</configuration>
