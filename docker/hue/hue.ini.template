# Configuración añadida sobre la de por defecto de la imagen (Hue carga
# todos los *.ini de desktop/conf/ en orden alfabético; "z-hue.ini" se
# aplica el último, así que sus valores ganan sobre los de por defecto).
#
# Esta es la PLANTILLA (versionada) — docker/00_init.sh genera el hue.ini
# real (gitignored) sustituyendo __POSTGRES_PASSWORD__ por la contraseña
# generada para el servicio "postgres" del compose (la misma que usa ese
# contenedor), para no dejar ninguna contraseña en un fichero versionado.

[desktop]
  [[database]]
    engine=sqlite3
    name=/usr/share/hue/desktop/db.sqlite3

[hadoop]
  [[hdfs_clusters]]
    [[[default]]]
      fs_defaultfs=hdfs://namenode:8020
      webhdfs_url=http://namenode:9870/webhdfs/v1

[beeswax]
  hive_server_host=hive-server2
  hive_server_port=10000
  hive_conf_dir=/hive_custom_conf

[notebook]
  [[interpreters]]
    [[[hive]]]
      name=Hive
      interface=hiveserver2
    [[[postgresql]]]
      name=PostgreSQL
      interface=sqlalchemy
      options='{"url": "postgresql://pyhdfsspark:__POSTGRES_PASSWORD__@postgres:5432/pyhdfsspark"}'
