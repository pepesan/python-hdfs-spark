    {
      "title": "kafka_consumidor",
      "text": "%pyspark\nimport pyspark.sql.functions as F\n\nmensajes \u003d spark.readStream.format(\"kafka\") \\\n    .option(\"kafka.bootstrap.servers\", \"kafka:29092\") \\\n    .option(\"subscribe\", \"frases_zeppelin\") \\\n    .option(\"startingOffsets\", \"earliest\") \\\n    .load()\n\ntexto \u003d mensajes.select(mensajes.value.cast(\"string\").alias(\"frase\"))\npalabras \u003d texto.select(F.explode(F.split(texto.frase, \" \")).alias(\"palabra\"))\nconteo \u003d palabras.groupBy(\"palabra\").count()\n\nconsulta \u003d conteo.writeStream.format(\"memory\").queryName(\"conteo_kafka_zeppelin\").outputMode(\"complete\").start()\nconsulta.awaitTermination(15)\nconsulta.stop()\nspark.sql(\"SELECT * FROM conteo_kafka_zeppelin ORDER BY palabra\").show()",
      "user": "anonymous",
      "dateUpdated": "2026-09-22 09:07:39.506",
      "progress": 0,
      "config": {
