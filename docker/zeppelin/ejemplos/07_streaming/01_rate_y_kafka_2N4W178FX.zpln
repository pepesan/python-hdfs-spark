    {
      "title": "kafka_productor",
      "text": "%pyspark\nfrom kafka import KafkaProducer\n\nproductor \u003d KafkaProducer(bootstrap_servers\u003d\"kafka:29092\")\nfor frase in [\"spark rdd example\", \"spark streaming example\", \"kafka spark ejemplo\"]:\n    productor.send(\"frases_zeppelin\", frase.encode(\"utf-8\"))\nproductor.flush()\nproductor.close()\nprint(\"mensajes enviados\")",
      "user": "anonymous",
      "dateUpdated": "2026-09-22 09:07:39.103",
