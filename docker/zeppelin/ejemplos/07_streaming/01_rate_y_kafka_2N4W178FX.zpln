    {
      "title": "kafka_productor",
      "text": "%pyspark\nfrom kafka import KafkaProducer\n\nproductor = KafkaProducer(bootstrap_servers=\"kafka:29092\")\nfor frase in [\"spark rdd example\", \"spark streaming example\", \"kafka spark ejemplo\"]:\n    productor.send(\"frases_zeppelin\", frase.encode(\"utf-8\"))\nproductor.flush()\nproductor.close()\nprint(\"mensajes enviados\")",
      "user": "anonymous",
