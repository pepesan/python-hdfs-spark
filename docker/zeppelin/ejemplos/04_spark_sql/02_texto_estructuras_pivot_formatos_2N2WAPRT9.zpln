    {
      "title": "pivot",
      "text": "%pyspark\nventas \u003d spark.createDataFrame([\n    (\"Ana\", \"Q1\", 1000), (\"Ana\", \"Q2\", 1500),\n    (\"Bruno\", \"Q1\", 800), (\"Bruno\", \"Q3\", 1200),\n], [\"vendedor\", \"trimestre\", \"importe\"])\n\nventas.groupBy(\"vendedor\").pivot(\"trimestre\", [\"Q1\", \"Q2\", \"Q3\", \"Q4\"]).agg(F.sum(\"importe\")).orderBy(\"vendedor\").show()",
