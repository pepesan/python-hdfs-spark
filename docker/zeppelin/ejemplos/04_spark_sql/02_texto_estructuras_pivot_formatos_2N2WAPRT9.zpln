          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "+---------------------+-------------------+------+\n|nombre               |nombre_sin_comillas|estado|\n+---------------------+-------------------+------+\n|John                 |John               |NJ    |\n|Jack                 |Jack               |PA    |\n|John \"Da Man\"        |John Da Man        |NJ    |\n|Stephen              |Stephen            |SD    |\n|NULL                 |NULL               |SD    |\n|Joan \"the bone\", Anne|Joan the bone, Anne|CO    |\n+---------------------+-------------------+------+\n\n"
          }
        ]
      },
