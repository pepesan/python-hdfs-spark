    {
      "title": "joins",
      "text": "%pyspark\npedidos \u003d spark.read.option(\"header\", \"true\").option(\"inferSchema\", \"true\").csv(\"/opt/project/files/pedidos.csv\")\ncondicion \u003d clientes.id \u003d\u003d pedidos.id_cliente\n\nprint(\"INNER: solo clientes CON pedidos\")\nclientes.join(pedidos, condicion, \"inner\").select(\"id\", \"nombre\", \"producto\").orderBy(\"id\").show()\n\nprint(\"LEFT ANTI: clientes SIN ningún pedido\")\nclientes.join(pedidos, condicion, \"left_anti\").orderBy(\"id\").show()\n\nprint(\"RIGHT: todos los pedidos, incluido el huérfano (id_cliente\u003d99)\")\nclientes.join(pedidos, condicion, \"right\").select(\"id_cliente\", \"nombre\", \"producto\").orderBy(\"id_pedido\" if False else \"id_cliente\").show()",
      "user": "anonymous",
      "dateUpdated": "2026-09-22 09:05:51.355",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
