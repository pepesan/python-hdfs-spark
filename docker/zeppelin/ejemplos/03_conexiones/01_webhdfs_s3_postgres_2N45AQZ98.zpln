    {
      "title": "s3_conexion",
      "text": "%pyspark\nimport json\nimport boto3\n\nwith open(\"/opt/project/docker/seaweedfs/s3-config/s3.json\") as f:\n    credenciales \u003d json.load(f)[\"identities\"][0][\"credentials\"][0]\n\ns3 \u003d boto3.client(\n    \"s3\",\n    endpoint_url\u003d\"http://seaweedfs:8333\",\n    aws_access_key_id\u003dcredenciales[\"accessKey\"],\n    aws_secret_access_key\u003dcredenciales[\"secretKey\"],\n    region_name\u003d\"us-east-1\",\n)\n\nbucket \u003d \"prueba\"\nif bucket not in [b[\"Name\"] for b in s3.list_buckets()[\"Buckets\"]]:\n    s3.create_bucket(Bucket\u003dbucket)\n\ns3.put_object(Bucket\u003dbucket, Key\u003d\"desde_zeppelin.txt\", Body\u003db\"hola desde zeppelin\")\nprint(s3.get_object(Bucket\u003dbucket, Key\u003d\"desde_zeppelin.txt\")[\"Body\"].read())",
      "user": "anonymous",
      "dateUpdated": "2026-09-22 09:04:44.775",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
