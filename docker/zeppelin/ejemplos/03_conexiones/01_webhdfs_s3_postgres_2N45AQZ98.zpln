    {
      "title": "postgres_jdbc",
      "text": "%pyspark\npassword \u003d open(\"/opt/project/docker/postgres/.env\").read().split(\"\u003d\")[1].strip()\n\nempleados \u003d spark.read.format(\"jdbc\") \\\n    .option(\"url\", \"jdbc:postgresql://postgres:5432/pyhdfsspark\") \\\n    .option(\"dbtable\", \"empleados\") \\\n    .option(\"user\", \"pyhdfsspark\") \\\n    .option(\"password\", password) \\\n    .option(\"driver\", \"org.postgresql.Driver\") \\\n    .load()\n\nempleados.show()",
      "user": "anonymous",
