    },
    {
      "title": "s3_modificar",
      "text": "%pyspark\nclave = \"desde_zeppelin.txt\"\noriginal = s3.get_object(Bucket=bucket, Key=clave)[\"Body\"].read()\nmodificado = original.decode(\"utf-8\").upper().encode(\"utf-8\")\ns3.put_object(Bucket=bucket, Key=clave, Body=modificado)\n\nreleido = s3.get_object(Bucket=bucket, Key=clave)[\"Body\"].read()\nprint(\"Original: \", original)\nprint(\"Modificado:\", releido)\nassert releido != original\n\ns3.delete_object(Bucket=bucket, Key=clave)",
      "user": "anonymous",
      "dateUpdated": "2026-09-21 22:19:14.696",
      "progress": 0,
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
