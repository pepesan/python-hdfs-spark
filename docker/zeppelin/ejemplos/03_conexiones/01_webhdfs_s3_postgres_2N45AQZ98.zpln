    {
      "title": "postgres_jdbc",
      "text": "%pyspark\npassword = open(\"/opt/project/docker/postgres/.env\").read().split(\"=\")[1].strip()\n\nempleados = spark.read.format(\"jdbc\") \\\n    .option(\"url\", \"jdbc:postgresql://postgres:5432/pyhdfsspark\") \\\n    .option(\"dbtable\", \"empleados\") \\\n    .option(\"user\", \"pyhdfsspark\") \\\n    .option(\"password\", password) \\\n    .option(\"driver\", \"org.postgresql.Driver\") \\\n    .load()\n\nempleados.show()",
      "user": "anonymous",
