    {
      "title": "webhdfs",
      "text": "%pyspark\nimport hdfs\n\nclient = hdfs.InsecureClient(\"http://namenode:9870\", user=\"hadoop\")\nclient.makedirs(\"/user/admin\")\nprint(\"listado:\", client.list(\"/user/admin\"))",
      "user": "anonymous",
