    {
      "title": "lpa",
      "text": "%pyspark\ncomunidades = graph.labelPropagation(maxIter=10)\ncomunidades.orderBy(\"id\").show()\nprint(\"Comunidades encontradas:\", comunidades.select(\"label\").distinct().count())",
