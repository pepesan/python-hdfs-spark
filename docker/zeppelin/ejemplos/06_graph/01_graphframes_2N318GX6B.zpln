    {
      "title": "cargar_grafo",
      "text": "%pyspark\nfrom graphframes import GraphFrame\n\nvertices \u003d spark.read.parquet(\"/opt/project/files/graph_vertices.snappy.parquet\")\nedges \u003d spark.read.parquet(\"/opt/project/files/graph_edges.snappy.parquet\")\ngraph \u003d GraphFrame(vertices, edges)\nprint(graph)",
