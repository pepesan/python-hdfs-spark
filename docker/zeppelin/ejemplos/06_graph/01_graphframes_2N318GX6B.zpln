    {
      "title": "cargar_grafo",
      "text": "%pyspark\nfrom graphframes import GraphFrame\n\nvertices = spark.read.parquet(\"/opt/project/files/graph_vertices.snappy.parquet\")\nedges = spark.read.parquet(\"/opt/project/files/graph_edges.snappy.parquet\")\ngraph = GraphFrame(vertices, edges)\nprint(graph)",
