    {
      "title": "als",
      "text": "%pyspark\nfrom pyspark.ml.recommendation import ALS\nfrom pyspark.ml.evaluation import RegressionEvaluator\n\npeliculas \u003d {0: \"Matrix\", 1: \"Inception\", 2: \"Interstellar\", 3: \"Titanic\", 4: \"El Diario de Noa\", 5: \"La La Land\"}\n\nvaloraciones \u003d spark.createDataFrame([\n    (0, 0, 5.0), (0, 1, 4.0),\n    (1, 0, 4.0), (1, 1, 5.0), (1, 2, 5.0),\n    (2, 0, 5.0), (2, 2, 4.0),\n    (0, 3, 1.0), (1, 4, 2.0), (2, 5, 1.0),\n    (3, 3, 5.0), (3, 4, 4.0),\n    (4, 4, 5.0), (4, 5, 5.0), (4, 3, 4.0),\n    (5, 5, 4.0), (5, 3, 5.0),\n    (3, 0, 1.0), (4, 1, 2.0), (5, 2, 1.0),\n], [\"usuario\", \"pelicula\", \"valoracion\"])\n\n(entrenamiento, prueba) \u003d valoraciones.randomSplit([0.8, 0.2], seed\u003d42)\nals \u003d ALS(userCol\u003d\"usuario\", itemCol\u003d\"pelicula\", ratingCol\u003d\"valoracion\", rank\u003d4, maxIter\u003d10, regParam\u003d0.1, seed\u003d42, coldStartStrategy\u003d\"drop\")\nmodelo_als \u003d als.fit(entrenamiento)\n\nevaluador_als \u003d RegressionEvaluator(metricName\u003d\"rmse\", labelCol\u003d\"valoracion\", predictionCol\u003d\"prediction\")\nprint(f\"RMSE: {evaluador_als.evaluate(modelo_als.transform(prueba)):.3f}\")\n\nrecs \u003d modelo_als.recommendForAllUsers(2)\nprint(\"Recomendaciones para el usuario 0 (fan de ciencia ficcion, nunca valoro Interstellar):\")\nfor r in recs.filter(recs.usuario \u003d\u003d 0).first().recommendations:\n    nombre_pelicula \u003d peliculas[r[\"pelicula\"]]\n    print(\"  \" + nombre_pelicula + \": \" + str(round(r[\"rating\"], 2)))",
