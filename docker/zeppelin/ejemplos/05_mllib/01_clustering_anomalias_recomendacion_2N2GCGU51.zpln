    {
      "title": "regresion",
      "text": "%pyspark\nfrom pyspark.ml.feature import VectorAssembler\nfrom pyspark.ml.regression import LinearRegression, DecisionTreeRegressor, GBTRegressor\nfrom pyspark.ml.evaluation import RegressionEvaluator\n\nhouse_df \u003d spark.read.csv(\"/opt/project/files/boston.csv\", header\u003dTrue, inferSchema\u003dTrue)\n\ncolumnas_features \u003d [\"CRIM\", \"ZN\", \"INDUS\", \"CHAS\", \"NOX\", \"RM\", \"AGE\", \"DIS\", \"RAD\", \"TAX\", \"PT\", \"B\", \"LSTAT\"]\nva_regr \u003d VectorAssembler(inputCols\u003dcolumnas_features, outputCol\u003d\"features\")\nvhouse_df \u003d va_regr.transform(house_df).select(\"features\", \"MV\")\n\ntrain_df, test_df \u003d vhouse_df.randomSplit([0.7, 0.3], seed\u003d3)\n\nevaluador_rmse \u003d RegressionEvaluator(labelCol\u003d\"MV\", predictionCol\u003d\"prediction\", metricName\u003d\"rmse\")\n\nfor nombre, modelo_regresor in [\n    (\"LinearRegression\", LinearRegression(featuresCol\u003d\"features\", labelCol\u003d\"MV\", maxIter\u003d10, regParam\u003d0.3, elasticNetParam\u003d0.8)),\n    (\"DecisionTreeRegressor\", DecisionTreeRegressor(featuresCol\u003d\"features\", labelCol\u003d\"MV\")),\n    (\"GBTRegressor\", GBTRegressor(featuresCol\u003d\"features\", labelCol\u003d\"MV\", maxIter\u003d10)),\n]:\n    modelo_entrenado \u003d modelo_regresor.fit(train_df)\n    predicciones_regr \u003d modelo_entrenado.transform(test_df)\n    rmse \u003d evaluador_rmse.evaluate(predicciones_regr)\n    print(f\"{nombre}: RMSE \u003d {rmse:.3f}\")",
